# Copy only for local use, or run `python3 scripts/prepare_demo.py`.
# Never commit the generated .env. All four service secrets must differ.

# Core serving
TREESEM_MODEL_BACKEND=onnx_fallback
TREESEM_SERVING_BUNDLE_DIR=/absolute/path/to/serving/bundle
TREESEM_MODEL_ADAPTER_URL=http://127.0.0.1:18081/v1/predict
TREESEM_MODEL_CONNECT_TIMEOUT_MS=500
TREESEM_MODEL_TIMEOUT_MS=5000
TREESEM_INFERENCE_WORKERS=4
TREESEM_INFERENCE_QUEUE_CAPACITY=64

# MySQL and Session
TREESEM_STORAGE_BACKEND=mysql
TREESEM_DB_HOST=127.0.0.1
TREESEM_DB_PORT=3307
TREESEM_DB_NAME=treesem
TREESEM_DB_USER=treesem_app
TREESEM_DB_PASSWORD=replace-with-random-secret
TREESEM_DB_ROOT_PASSWORD=replace-with-another-random-secret
TREESEM_DB_POOL_SIZE=8
TREESEM_DB_ACQUIRE_TIMEOUT_MS=500
TREESEM_DB_CONNECT_TIMEOUT_MS=1000
TREESEM_DB_READ_TIMEOUT_MS=2000
TREESEM_DB_WRITE_TIMEOUT_MS=2000
TREESEM_DATABASE_WORKERS=4
TREESEM_DATABASE_QUEUE_CAPACITY=64
TREESEM_SESSION_TTL_SECONDS=3600
TREESEM_COOKIE_SECURE=false

# Agent and LLM
TREESEM_AGENT_ENABLED=true
TREESEM_AGENT_URL=http://127.0.0.1:8091/v1/agent/runs
TREESEM_AGENT_BACKEND_URL=http://127.0.0.1:8080
TREESEM_AGENT_CONNECT_TIMEOUT_MS=500
TREESEM_AGENT_TIMEOUT_MS=30000
TREESEM_AGENT_WORKERS=4
TREESEM_AGENT_QUEUE_CAPACITY=64
TREESEM_AGENT_MAX_STEPS=5
TREESEM_AGENT_MAX_TOOL_CALLS=8
TREESEM_AGENT_TOTAL_TIMEOUT_MS=25000
TREESEM_AGENT_CONTEXT_MESSAGES=12
TREESEM_AGENT_MESSAGE_MAX_CHARS=4000
TREESEM_AGENT_RESPONSE_MAX_BYTES=1048576
TREESEM_AGENT_LLM_MODE=scripted_demo
TREESEM_AGENT_LLM_BASE_URL=
TREESEM_AGENT_LLM_MODEL=
TREESEM_AGENT_LLM_API_KEY=
TREESEM_AGENT_LLM_TEMPERATURE=0
TREESEM_AGENT_LLM_ENABLE_THINKING=false
TREESEM_AGENT_LLM_MAX_OUTPUT_TOKENS=1024

# Agent routing. The base image stays lightweight in rule mode. Set both
# TREESEM_INSTALL_SEMANTIC_ROUTING=true and a hybrid mode to enable embeddings.
TREESEM_INSTALL_SEMANTIC_ROUTING=false
TREESEM_AGENT_ROUTING_MODE=rule
TREESEM_AGENT_ROUTING_MODEL=intfloat/multilingual-e5-small
TREESEM_AGENT_ROUTING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
TREESEM_AGENT_ROUTING_EMBEDDING_BACKEND=onnx_int8
# Required only for hybrid_optional/hybrid_required. Generated routing
# artifacts are local, checksum-verified, and mounted read-only in Compose.
TREESEM_AGENT_ROUTING_ARTIFACT_DIR=/absolute/path/to/routing/artifact
TREESEM_AGENT_ROUTING_WORKERS=1
TREESEM_AGENT_ROUTING_QUEUE_CAPACITY=8
TREESEM_AGENT_ROUTING_ADMISSION_TIMEOUT_MS=5
TREESEM_AGENT_ROUTING_TIMEOUT_MS=150

# Optional outbound proxy for the Agent container when the cloud API is not
# directly reachable. Keep internal service names in NO_PROXY.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,backend,knowledge,model-adapter,mysql

# Authentication and internal capabilities
TREESEM_AUTH_MODE=required
TREESEM_DEPLOYMENT_ENV=local
TREESEM_ACCESS_JWT_SECRET=replace-with-at-least-32-random-characters
TREESEM_CAPABILITY_JWT_SECRET=replace-with-a-different-secret
TREESEM_AGENT_SERVICE_SECRET=replace-with-a-third-distinct-secret
TREESEM_ACCESS_TOKEN_TTL_SECONDS=900
TREESEM_REFRESH_TOKEN_TTL_SECONDS=604800
TREESEM_CAPABILITY_TOKEN_TTL_SECONDS=120
TREESEM_REFRESH_COOKIE_SECURE=false
TREESEM_ALLOWED_ORIGINS=http://127.0.0.1:3000
TREESEM_AUTH_WORKERS=2
TREESEM_AUTH_QUEUE_CAPACITY=32

# RAG / MCP / Skill
TREESEM_KNOWLEDGE_ENABLED=true
TREESEM_KNOWLEDGE_JWT_SECRET=replace-with-a-fourth-distinct-secret
TREESEM_KNOWLEDGE_TOKEN_TTL_SECONDS=120
TREESEM_KNOWLEDGE_MCP_URL=http://127.0.0.1:8092/mcp
TREESEM_KNOWLEDGE_INDEX_DIR=/absolute/path/to/knowledge/index
TREESEM_HF_CACHE_DIR=/absolute/path/to/huggingface/cache
TREESEM_KNOWLEDGE_WORKERS=1
TREESEM_KNOWLEDGE_QUEUE_CAPACITY=16
TREESEM_KNOWLEDGE_REQUEST_TIMEOUT_MS=3000
TREESEM_KNOWLEDGE_MAX_RESPONSE_BYTES=65536
TREESEM_AGENT_SKILLS_ENABLED=true
TREESEM_AGENT_SKILLS_DIR=/absolute/path/to/PythonServices/TreeSemAgent/skills

# Observability
TREESEM_OBSERVABILITY_ENABLED=true
TREESEM_METRICS_ENABLED=true
TREESEM_METRICS_BEARER_TOKEN=
TREESEM_RUNTIME_UID=1000
TREESEM_RUNTIME_GID=1000
TREESEM_TRACE_SAMPLE_RATE=1.0
TREESEM_SLOW_REQUEST_MS=1000

# Reproducible demo fixtures
TREESEM_DEMO_ADMIN_EMAIL=admin@treesem.local
TREESEM_DEMO_ADMIN_PASSWORD=replace-with-demo-password
TREESEM_DEMO_PATIENT_EMAIL=patient@treesem.local
TREESEM_DEMO_PATIENT_PASSWORD=replace-with-demo-password
TREESEM_DEMO_DOCTOR_EMAIL=doctor@treesem.local
TREESEM_DEMO_DOCTOR_PASSWORD=replace-with-demo-password
