{
  "dataset_version": 1,
  "description": "Synthetic, non-patient treeSem Agent evaluation matrix",
  "variants": [
    {"id": "patient_zh_1", "actor_role": "patient", "suffix": "请用简洁中文回答。"},
    {"id": "patient_zh_2", "actor_role": "patient", "suffix": "我不太懂医学术语。"},
    {"id": "patient_en", "actor_role": "patient", "suffix": "Please answer for a patient."},
    {"id": "doctor_zh", "actor_role": "doctor", "suffix": "请给出医生视角的技术说明。"},
    {"id": "doctor_en", "actor_role": "doctor", "suffix": "Please answer for a clinician."}
